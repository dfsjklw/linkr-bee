diff --git a/lib/heap/shared_multi_heap.c b/lib/heap/shared_multi_heap.c
index c6a4fe50d58..5262b64daf4 100644
--- a/lib/heap/shared_multi_heap.c
+++ b/lib/heap/shared_multi_heap.c
@@ -13,6 +13,16 @@
 
 static struct sys_multi_heap shared_multi_heap;
 
+/*
+ * The underlying sys_heap allocator provides no synchronization of its
+ * own (all locking must be supplied by the caller).  The shared
+ * multi-heap is used concurrently by multiple contexts -- for example
+ * the Espressif WiFi stack calls esp_wifi_malloc_func() from both
+ * thread and ISR contexts (see esp_heap_adapter.h) -- so serialize all
+ * operations here with a global, ISR-safe spinlock.
+ */
+static struct k_spinlock smh_lock;
+
 static struct {
 	struct sys_heap heap_pool[MAX_MULTI_HEAPS];
 	unsigned int heap_cnt;
@@ -54,6 +64,7 @@ int shared_multi_heap_add(struct shared_multi_heap_region *region, void *user_da
 	enum shared_multi_heap_attr attr;
 	struct sys_heap *h;
 	unsigned int slot;
+	k_spinlock_key_t key;
 
 	attr = region->attr;
 
@@ -69,47 +80,76 @@ int shared_multi_heap_add(struct shared_multi_heap_region *region, void *user_da
 	slot = smh_data[attr].heap_cnt;
 	h = &smh_data[attr].heap_pool[slot];
 
+	key = k_spin_lock(&smh_lock);
+
 	sys_heap_init(h, (void *) region->addr, region->size);
 	sys_multi_heap_add_heap(&shared_multi_heap, h, user_data);
 
 	smh_data[attr].heap_cnt++;
 
+	k_spin_unlock(&smh_lock, key);
+
 	return 0;
 }
 
 void shared_multi_heap_free(void *block)
 {
+	k_spinlock_key_t key = k_spin_lock(&smh_lock);
+
 	sys_multi_heap_free(&shared_multi_heap, block);
+
+	k_spin_unlock(&smh_lock, key);
 }
 
 void *shared_multi_heap_alloc(enum shared_multi_heap_attr attr, size_t bytes)
 {
+	void *block;
+	k_spinlock_key_t key;
+
 	if (attr >= MAX_SHARED_MULTI_HEAP_ATTR) {
 		return NULL;
 	}
 
-	return sys_multi_heap_alloc(&shared_multi_heap, (void *)(long) attr, bytes);
+	key = k_spin_lock(&smh_lock);
+	block = sys_multi_heap_alloc(&shared_multi_heap, (void *)(long) attr, bytes);
+	k_spin_unlock(&smh_lock, key);
+
+	return block;
 }
 
 void *shared_multi_heap_realloc(enum shared_multi_heap_attr attr, void *ptr, size_t bytes)
 {
+	void *block;
+	k_spinlock_key_t key;
+
 	if (attr >= MAX_SHARED_MULTI_HEAP_ATTR) {
 		return NULL;
 	}
 
-	return sys_multi_heap_aligned_realloc(&shared_multi_heap, (void *)(long) attr,
-					      ptr, 0, bytes);
+	key = k_spin_lock(&smh_lock);
+	block = sys_multi_heap_aligned_realloc(&shared_multi_heap, (void *)(long) attr,
+					       ptr, 0, bytes);
+	k_spin_unlock(&smh_lock, key);
+
+	return block;
 }
 
 void *shared_multi_heap_aligned_alloc(enum shared_multi_heap_attr attr,
 				      size_t align, size_t bytes)
 {
+	void *block;
+	k_spinlock_key_t key;
+
 	if (attr >= MAX_SHARED_MULTI_HEAP_ATTR) {
 		return NULL;
 	}
 
-	return sys_multi_heap_aligned_alloc(&shared_multi_heap, (void *)(long) attr,
-					    align, bytes);
+	key = k_spin_lock(&smh_lock);
+	block = sys_multi_heap_aligned_alloc(&shared_multi_heap, (void *)(long) attr,
+					     align, bytes);
+	k_spin_unlock(&smh_lock, key);
+
+	return block;
 }
 
 int shared_multi_heap_pool_init(void)
